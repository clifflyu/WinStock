# ---- 本地数据 ----
# data/ 是默认库目录，全量约 174 MB；*.db 兜住 --db 指定的其他路径。
# 这两个库都可以用 `python -m winstocker init` 重新生成，不入库。
data/
*.db
*.db-wal
*.db-shm

# ---- 运行日志 ----
# 例：python -m winstocker init 2>&1 | tee init.log
*.log

# ---- 密钥 ----
# .env 存飞书 Webhook。这是凭据：任何拿到它的人都能往群里发消息，而本仓库是
# 公开的——一旦提交，历史里就永久留痕（改密钥才能补救）。
# 注意 `env/` 只匹配名为 env 的目录，拦不住 .env 这个文件，必须单列。
.env
notify.env

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 测试与静态检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 编辑器与操作系统 ----
.DS_Store
.idea/
.vscode/
*.swp
