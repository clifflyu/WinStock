[Unit]
Description=WinStock weekly fundamentals and industry snapshot update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__WINSTOCK_USER__
WorkingDirectory=__WINSTOCK_DIR__
Environment="PYTHONUNBUFFERED=1"
ExecStart=__WINSTOCK_PYTHON__ -m winstocker --db __WINSTOCK_DB__ enrich
Nice=15
UMask=0077
