[Unit]
Description=WinStock daily update, audit, candidate snapshot, and Feishu push
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__WINSTOCK_USER__
WorkingDirectory=__WINSTOCK_DIR__
Environment="PYTHONUNBUFFERED=1"
Environment="WINSTOCK_PYTHON=__WINSTOCK_PYTHON__"
Environment="WINSTOCK_DB=__WINSTOCK_DB__"
# 飞书凭据由 Python 自行从项目根目录的 .env 读取（该文件已在 .gitignore 中），
# 因此这里不需要 EnvironmentFile；缺失时 daily 会推送失败并给出中文提示。
Nice=10
UMask=0077
# daily 内部串起 更新 → 审计 → 候选池 → 飞书推送。刻意不再用 shell 的 set -e 串联：
# 那样 update 一失败后面全部不执行，用户整晚收不到任何消息，而沉默无法与「今天没事」区分。
ExecStart=/bin/bash -lc 'exec "$WINSTOCK_PYTHON" -m winstocker --db "$WINSTOCK_DB" daily'
